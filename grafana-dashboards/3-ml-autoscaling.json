        {"expr":"sum(kube_pod_container_resource_requests{namespace=\"myapp\",container=\"web\",resource=\"cpu\"}) * 1000 * 0.7","legendFormat":"HPA Threshold (70% of request)","refId":"B"},
        {"expr":"sum(kube_pod_container_resource_limits{namespace=\"myapp\",container=\"web\",resource=\"cpu\"}) * 1000","legendFormat":"Total CPU Limit","refId":"C"}
      ],"fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":2,"fillOpacity":10,"drawStyle":"line","showPoints":"auto","pointSize":5}},"overrides":[
        {"matcher":{"id":"byName","options":"HPA Threshold (70% of request)"},"properties":[{"id":"custom.lineStyle","value":{"fill":"dash","dash":[10,10]}},{"id":"color","value":{"fixedColor":"red","mode":"fixed"}}]},
        {"matcher":{"id":"byName","options":"Total CPU Limit"},"properties":[{"id":"custom.lineStyle","value":{"fill":"dash","dash":[4,4]}},{"id":"color","value":{"fixedColor":"orange","mode":"fixed"}}]},
        {"matcher":{"id":"byName","options":"Actual CPU (millicores)"},"properties":[{"id":"color","value":{"fixedColor":"#00d4ff","mode":"fixed"}}]}
      ]}},

      {"id":11,"type":"timeseries","title":"Scaling Events: Replica Count Changes","description":"Watch this graph during load tests. The predictive scaler increases replicas BEFORE CPU hits the HPA threshold.","gridPos":{"h":8,"w":12,"x":0,"y":14},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[
