      {"id":10,"type":"timeseries","title":"Pipeline: CPU Actual + HPA Threshold + Scaling","description":"Shows actual CPU, the 70% HPA threshold line, and current replicas. When CPU approaches the threshold, the predictive scaler acts BEFORE HPA.","gridPos":{"h":10,"w":24,"x":0,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[
