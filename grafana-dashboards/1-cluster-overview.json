{
  "dashboard": {
    "title": "1. Cluster Overview",
    "tags": ["project"],
    "timezone": "utc",
    "refresh": "15s",
    "panels": [
      {"id":1,"type":"stat","title":"Nodes Ready","gridPos":{"h":4,"w":6,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})","refId":"A"}],"fieldConfig":{"defaults":{"thresholds":{"steps":[{"value":0,"color":"red"},{"value":3,"color":"green"}]}}}},
      {"id":2,"type":"stat","title":"Total Pods","gridPos":{"h":4,"w":6,"x":6,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"count(kube_pod_info)","refId":"A"}],"fieldConfig":{"defaults":{"thresholds":{"steps":[{"value":0,"color":"blue"}]}}}},
      {"id":3,"type":"stat","title":"Pod Restarts (1h)","gridPos":{"h":4,"w":6,"x":12,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(kube_pod_container_status_restarts_total[1h]))","refId":"A"}],"fieldConfig":{"defaults":{"thresholds":{"steps":[{"value":0,"color":"green"},{"value":3,"color":"yellow"},{"value":10,"color":"red"}]}}}},
      {"id":4,"type":"stat","title":"Running Pods","gridPos":{"h":4,"w":6,"x":18,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"count(kube_pod_status_phase{phase=\"Running\"})","refId":"A"}],"fieldConfig":{"defaults":{"thresholds":{"steps":[{"value":0,"color":"red"},{"value":10,"color":"green"}]}}}},

      {"id":10,"type":"gauge","title":"master-node CPU","gridPos":{"h":6,"w":4,"x":0,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 - (avg(rate(node_cpu_seconds_total{instance=~\"10.0.1.7:.*\",mode=\"idle\"}[5m])) * 100)","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"value":0,"color":"green"},{"value":50,"color":"yellow"},{"value":80,"color":"red"}]}}}},
      {"id":11,"type":"gauge","title":"worker-1 CPU","gridPos":{"h":6,"w":4,"x":4,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 - (avg(rate(node_cpu_seconds_total{instance=~\"10.0.1.105:.*\",mode=\"idle\"}[5m])) * 100)","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"value":0,"color":"green"},{"value":50,"color":"yellow"},{"value":80,"color":"red"}]}}}},
      {"id":12,"type":"gauge","title":"worker-2 CPU","gridPos":{"h":6,"w":4,"x":8,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 - (avg(rate(node_cpu_seconds_total{instance=~\"10.0.1.114:.*\",mode=\"idle\"}[5m])) * 100)","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"value":0,"color":"green"},{"value":50,"color":"yellow"},{"value":80,"color":"red"}]}}}},
      {"id":13,"type":"gauge","title":"master-node RAM","gridPos":{"h":6,"w":4,"x":12,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"(1 - node_memory_MemAvailable_bytes{instance=~\"10.0.1.7:.*\"} / node_memory_MemTotal_bytes{instance=~\"10.0.1.7:.*\"}) * 100","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"value":0,"color":"green"},{"value":60,"color":"yellow"},{"value":85,"color":"red"}]}}}},
      {"id":14,"type":"gauge","title":"worker-1 RAM","gridPos":{"h":6,"w":4,"x":16,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"(1 - node_memory_MemAvailable_bytes{instance=~\"10.0.1.105:.*\"} / node_memory_MemTotal_bytes{instance=~\"10.0.1.105:.*\"}) * 100","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"value":0,"color":"green"},{"value":60,"color":"yellow"},{"value":85,"color":"red"}]}}}},
      {"id":15,"type":"gauge","title":"worker-2 RAM","gridPos":{"h":6,"w":4,"x":20,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"(1 - node_memory_MemAvailable_bytes{instance=~\"10.0.1.114:.*\"} / node_memory_MemTotal_bytes{instance=~\"10.0.1.114:.*\"}) * 100","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"value":0,"color":"green"},{"value":60,"color":"yellow"},{"value":85,"color":"red"}]}}}},

      {"id":20,"type":"timeseries","title":"Cluster CPU Usage Over Time","gridPos":{"h":8,"w":12,"x":0,"y":10},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)","legendFormat":"{{instance}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"custom":{"lineWidth":2,"fillOpacity":10}}}},
      {"id":21,"type":"timeseries","title":"Cluster Memory Usage Over Time","gridPos":{"h":8,"w":12,"x":12,"y":10},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100","legendFormat":"{{instance}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"custom":{"lineWidth":2,"fillOpacity":10}}}}
    ]
  },
  "folderUid": "bfhec5v8wybr4c",
  "overwrite": true
}
